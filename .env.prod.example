# Copy to .env.prod and fill in. NEVER commit the real file (it is git-ignored).
DOMAIN=karkai.example.in
PUBLIC_URL=https://karkai.example.in
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Tutor model (optional, but without it the tutor is rule-based)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Azure speech (optional; without it the browser voice is used)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Email (optional; without it password-reset and guardian-approval mails are not sent)
MAIL_FROM="Karkai AI <no-reply@karkai.example.in>"
RESEND_API_KEY=

# Show only the textbooks the admin uploads (no built-in sample content)
BOOK_ONLY=1
