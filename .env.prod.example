# Copy to .env.prod and fill in. NEVER commit the real file (it is git-ignored).
DOMAIN=karkai.example.in
PUBLIC_URL=https://karkai.example.in
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Tutor model (optional, but without it the tutor is rule-based). Pick ONE of the two options.
# Option A, free tier: Google Gemini through its OpenAI-compatible endpoint. Create a key in Google AI Studio,
# uncomment these four lines and confirm the model name and current free limits in AI Studio first.
# Free-tier terms may allow the provider to use prompts to improve its products; the app sends only the question text,
# retrieved book passages and the class level (no names or emails), but read the terms before real students use it.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# Option B, paid: Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Azure speech (optional; without it the browser voice is used)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Email (optional; without it password-reset and guardian-approval mails are not sent)
MAIL_FROM="Karkai AI <no-reply@karkai.example.in>"
RESEND_API_KEY=

# Show only the textbooks the admin uploads (no built-in sample content)
BOOK_ONLY=1
